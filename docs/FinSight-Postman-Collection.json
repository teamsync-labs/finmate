{
  "info": {
    "name": "FinSight API",
    "description": "Коллекция для тестирования API финансового помощника FinSight\n\n## Предусловия\n1. Запустите сервер: `uvicorn app.main:app --reload`\n2. Создайте окружение Postman с переменной `base_url` = `http://localhost:8000`\n3. Импортируйте коллекцию\n4. Сначала выполните **Auth → Telegram Auth** — токен автоматически сохранится\n5. Остальные запросы — в любом порядке\n\n## Аутентификация\nВся аутентификация — через Telegram. Один эндпоинт `/auth/telegram`:\n- Если `telegram_id` не найден — создаётся новый пользователь\n- Если найден — обновляется username и выдаётся JWT-токен\n\n## Расходы\nРасходы (`/expenses`) — основная сущность приложения. У каждого расхода есть:\n- `expense_name` — название (обязательное, до 100 символов)\n- `amount` — сумма (>= 0, по умолчанию 0.0)\n- `type` — категория: general, food, transport, housing, utilities, entertainment, health, education, shopping, other\n- `currency` — ISO-код валюты (по умолчанию RUB)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "expense_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "telegram_id",
      "value": "123456789",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Аутентификация через Telegram (единый эндпоинт для входа и регистрации)",
      "item": [
        {
          "name": "Telegram Auth — Вход/Регистрация",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Проверка статус-кода",
                  "pm.test('Status 200 — успешная аутентификация', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Проверка наличия токена",
                  "pm.test('Ответ содержит access_token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access_token');",
                  "    pm.expect(json).to.have.property('token_type');",
                  "    pm.expect(json).to.have.property('telegram_id');",
                  "    pm.expect(json).to.have.property('username');",
                  "    pm.expect(json.token_type).to.eql('bearer');",
                  "    pm.expect(json.access_token).to.match(/^[A-Za-z0-9._-]+\\.[A-Za-z0-9._-]+\\.[A-Za-z0-9._-]+$/);",
                  "});",
                  "",
                  "// Сохраняем токен в переменную коллекции",
                  "pm.test('Токен сохранён для последующих запросов', function () {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.access_token);",
                  "    pm.expect(pm.collectionVariables.get('token')).to.not.eql('');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telegram_id\": {{telegram_id}},\n  \"username\": \"test_user\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/telegram",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "telegram"
              ]
            },
            "description": "Вход или регистрация через Telegram. JWT-токен автоматически сохраняется в переменную `token` коллекции."
          }
        },
        {
          "name": "Telegram Auth — Повторный вызов (обновление профиля)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 — токен получен', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Токен обновлён', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access_token');",
                  "    pm.collectionVariables.set('token', json.access_token);",
                  "});",
                  "",
                  "pm.test('Username обновлён', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.username).to.eql('test_user_updated');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telegram_id\": {{telegram_id}},\n  \"username\": \"test_user_updated\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/telegram",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "telegram"
              ]
            },
            "description": "Повторный вызов с другим username — профиль обновится, а не создастся новый пользователь."
          }
        }
      ]
    },
