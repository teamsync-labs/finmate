# ===== DOCKER IMAGES =====
IMAGE_PREFIX=finmate
IMAGE_TAG=latest

COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# ===== POSTGRESQL =====
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight
POSTGRES_DB=finsight
# optional full URL; otherwise backend builds from POSTGRES_*
# DATABASE_URL=postgresql://finsight:finsight@db:5432/finsight

# ===== BACKEND =====
DEBUG=false
SECRET_KEY=change-me-local-only
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
BOT_SERVICE_KEY=какой-то-длинный-случайный-секрет
# for develop
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_OCR_MODEL=hf.co/TirGun/Qwen3-VL-4B-Thinking-GGUF:Q4_K_M
OLLAMA_TIMEOUT_SECONDS=120

# ===== ENTRY (compose-nginx) =====
NGINX_PORT=8088
NGINX_BIND=0.0.0.0
ACCESS_VIA_DOMAIN=false
APP_DOMAIN=finmate.space
HEALTHCHECK_URL=http://127.0.0.1:8088/health
APP_PUBLIC_URL=http://127.0.0.1:8088
